#!/bin/sh
# `gh` の入口（`/usr/local/bin/gh`）。**素の `gh`（`/usr/bin/gh`）を隠すためではなく、
# 鍵の読み場所を1つ挟むためのシムである。**
#
# **以前は、マネージャー・作業者の uid からの release-prod（本番デプロイ）の起動を exit 1 で止める門が
# ここに在った（#865）。外した（#2884）。** 止めるだけで確認に上がらず、クローンが許可しても通らなかった。
# いまは Bash の `PreToolUse`（`packages/core/src/bash-release-prod-guard.ts` と `runner.ts` の
# `#onPreToolUse`）が確認（ask）に上げる。硬い境界は `release/prod` の ruleset 側にしか置けない（現状の扱いは #889 と #2953）。
#
# 鍵は毎回ファイルから読む（走行中の差し替えを届かせるため）。
# **扱う鍵ぜんぶを読む。** 片方だけ読むと「回せる」と言いながら回らない鍵ができる。
set -eu

d="${ALTEROID_CREDENTIAL_DIR:-/run/alteroid/credentials}"
for n in GH_TOKEN GITHUB_TOKEN; do
  # `ALTEROID_<NAME>_FILE` が**明示的に置かれている**か。置かれているのは、器（runner）が
  # その名前の鍵を持っていた層だけである（`credentials.ts` の `CredentialStore#env`）。
  eval "explicit=\${ALTEROID_${n}_FILE:-}"
  eval "f=\${ALTEROID_${n}_FILE:-$d/$n}"
  t=""
  if [ -r "$f" ]; then t="$(cat "$f")"; fi
  if [ -n "$t" ]; then
    eval "$n=\$t"; export "$n"
  elif [ -n "$explicit" ]; then
    # **削除を走行中の gh / git へ届ける**（2026-10-06 のオーナー決定「環境変数を即時反映に」）。
    # 子プロセスの env は起動時に凍るので、鍵を外しても（ファイルが消えても）起動時の値が
    # 残り続ける。**所在が明示されているのにファイルが無い（または空）なら、外されたと読んで
    # 凍った値を捨てる。** 空を export すると「鍵が無い」より悪い（hosts.yml も無視される）ので
    # 空を入れるのではなく unset する。
    # **所在が置かれていない層（器にファイル置き場が無いクローンなど）では何もしない**——
    # そこでは GH_TOKEN は env から来ており、ファイルが無いのは「外された」ではないので、
    # 消すと鍵を失う。
    unset "$n"
  fi
done
# 実行環境プロファイル（人間の .zprofile 相当）も読む。**鍵より後**に読むのは、
# 人間が明示的に書いたほうを勝たせるためである（`profile.ts` と同じ順序）。
# Bash 経由なら BASH_ENV で既に読まれているので、番人が二度読みを止める。
p="${ALTEROID_PROFILE_FILE:-/run/alteroid/profile/profile.sh}"
# 本文の標準出力は stderr へ寄せる（gh の出力に混ぜない）。
if [ -r "$p" ]; then . "$p" >&2 || true; fi

# **本物の gh。** テストで差し替えられるように変数へ出す（既定はこれまでどおり
# `/usr/bin/gh` 決め打ち。本番の挙動は1文字も変えていない）。
REAL_GH="${ALTEROID_GH_REAL_BIN:-/usr/bin/gh}"


exec "$REAL_GH" "$@"
