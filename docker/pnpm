#!/bin/sh
# pnpm の入口（#5009）。corepack は pnpm の版を「いまの作業ディレクトリ」の package.json の packageManager で決めるので、
# 担当が作業場の外から `pnpm -C <絶対パス> …` と打つと、corepack は既定の最新を選び、リポジトリの指定と食い違って止まる
# （pnpm は corepack の下では自分で版を切り替えない）。`-C` / `--dir` に絶対パスがあれば、そこへ移ってから corepack を起こす。
# 引数はそのまま渡す（パスは絶対なので、移った後も同じ場所を指す）。相対パス・指定なしのときは今どおり。
set -eu
dir=''
prev=''
max_workers_arg=''
for arg in "$@"; do
  case "$prev" in
    -C | --dir) dir=$arg ;;
  esac
  case "$arg" in
    --dir=*) dir=${arg#--dir=} ;;
    -C/*) dir=${arg#-C} ;;
    --maxWorkers* | --max-workers*) max_workers_arg=1 ;;
  esac
  prev=$arg
done
case "$dir" in
  /*) if [ -d "$dir" ]; then cd "$dir"; fi ;;
esac
# pnpm 12（Rust 製の pnpm-native）のスレッドを絞る（#5036）。器の pids の上限はスレッド単位で数えられるが、
# pnpm-native は cgroup の CPU 数（24）に合わせて tokio のワーカー 24 本と rayon の池 16 本を立て、
# `pnpm --filter … start` のように子を待つ間ずっと常駐させる（実測: 43 → 2 と 2 で 5）。担当が値を置けばそれに従う
TOKIO_WORKER_THREADS=${TOKIO_WORKER_THREADS:-2}
RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-2}
export TOKIO_WORKER_THREADS RAYON_NUM_THREADS
# vite 8 の rolldown も CPU 数に合わせて rolldown-worker を 48 本立て、vite preview・vitest の本体に常駐させる（#5039）。
# rayon の池と別に自前の tokio を持つので、上の2つと合わせて絞る（実測: 59 → 12。build は遅くならなかった）
ROLLDOWN_WORKER_THREADS=${ROLLDOWN_WORKER_THREADS:-2}
ROLLDOWN_MAX_BLOCKING_THREADS=${ROLLDOWN_MAX_BLOCKING_THREADS:-2}
export ROLLDOWN_WORKER_THREADS ROLLDOWN_MAX_BLOCKING_THREADS
# vitest の worker の既定は availableParallelism - 1（この器では 31。1本 7 スレッド）なので、alteroid の vitest.config.ts と同じ 4 にする。
# VITEST_MAX_WORKERS は設定ファイルと CLI の --maxWorkers を上書きするので、引数に --maxWorkers があるときは置かない（担当の指定を消さない）
if [ -z "$max_workers_arg" ]; then
  VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-4}
  export VITEST_MAX_WORKERS
fi
exec corepack pnpm "$@"
