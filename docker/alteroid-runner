#!/bin/sh
# manager-runner を起こす。
#
# **ここで合鍵を畳む。** 人間が置くのは app と runner で同じ `ALTEROID_RUNNER_TOKEN`
# ひとつだけでよい（＝一致させるだけ）。畳んだ素の値は `exec` の前に環境から落とす
# ので、**runner のプロセスには sha256 しか残らない**。
#
# 同じ理由で、**入口の認証（ログイン）の鍵も `exec` の前に落とす**（下部）。
# 人間は共有の1か所に置くだけでよく、走っている runner はそれを持たない。
#
# なぜ落とすのか。素の鍵が runner の環境に残ると、UID の分離が崩れた場面で子プロセス
# （＝マネージャー）が `/proc/1/environ` から読める。読めた瞬間、自分宛の許可確認に
# 自分で `allow` を返せる — クローンも人間も通らない迂回路ができる
# （docs/architecture.md「制御面の保護」3枚目）。
#
# 人間の手元が楽になっただけで、守りは1枚も減っていない。減らすなら別の話として
# 承認を取ること。
set -eu

# sha256 を出す道具はプラットフォームで名前が違う（Linux: sha256sum / macOS: shasum）。
# **どちらでも動かす** — このスクリプトは器の中だけでなく、手元の検証でも走る。
fold() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf %s "$1" | sha256sum | cut -d' ' -f1
  else
    printf %s "$1" | shasum -a 256 | cut -d' ' -f1
  fi
}

if [ -n "${ALTEROID_RUNNER_TOKEN:-}" ]; then
  folded="$(fold "$ALTEROID_RUNNER_TOKEN")"
  # 両方置かれていて食い違うのが最悪である（人間は「置いた」、runner は 401 を返し
  # 続け、どちらも正しいまま噛み合わない）。黙って片方を選ばず、ここで落とす。
  if [ -n "${ALTEROID_RUNNER_TOKEN_SHA256:-}" ] && [ "$folded" != "$ALTEROID_RUNNER_TOKEN_SHA256" ]; then
    echo 'alteroid-runner: ALTEROID_RUNNER_TOKEN と ALTEROID_RUNNER_TOKEN_SHA256 が食い違っている（どちらか一方だけを置くこと）' >&2
    exit 1
  fi
  ALTEROID_RUNNER_TOKEN_SHA256="$folded"
  export ALTEROID_RUNNER_TOKEN_SHA256
fi

# 置かれていなくても必ず消す（器を作り直す前の値を持ち越さない）。
unset ALTEROID_RUNNER_TOKEN

# **入口の認証（ログイン）の鍵も落とす。** runner はこれを1つも使わない。
#
# 残すと、UID の分離が崩れた場面で子プロセス（＝マネージャー）が
# `/proc/1/environ` から読める。読めた瞬間、自分でアクセストークンを発行して
# HTTP API 経由で記憶へ届く — 合鍵とまったく同じ理由でここで落とす。
#
# 伏せるのは**上（記憶）へ到達する鍵**だけである。`GH_TOKEN` のように
# **下（外の世界）へ手を伸ばす鍵**は渡すのが正しく、ここに足してはいけない
# （足した瞬間、人間が Claude Code でできることが層を下りて消える＝デグレード）。
unset ALTEROID_GOOGLE_CLIENT_ID
unset ALTEROID_GOOGLE_CLIENT_SECRET

# **pid 1 を tini にする（#315）。** コンテナで pid 1 になった `node` は init の仕事を
# 持たない — 孤児として引き取った子孫（マネージャー配下の subprocess の残骸）を
# reap（wait）せず、ゾンビのまま溜める。実測(2026-08-28 観測、Issue #315):
# `runner-3` で pids 955/1000 のうち 779（81.6%）が `ppid=1` のゾンビだった。
# `tini` は SIGCHLD を受けて代わりに wait するだけの小さな init で、それを
# pid 1 に据えて node をその子にする。
#
# **なぜ `ENTRYPOINT ["tini","--"]` ではなくここで `exec` するのか。** ENTRYPOINT
# 形にすると pid 1（tini）は上の unset より前の環境 — 素の `ALTEROID_RUNNER_TOKEN` と
# `ALTEROID_GOOGLE_CLIENT_SECRET` を持ったまま起動し、`/proc/1/environ` に残ってしまう。
# それは上で畳んでいる守りの3枚目を無に帰す。**tini は必ず、合鍵を畳み鍵を落とした
# 後のこのシムの内側から `exec` する。**
#
# **なぜ `-g` を付けないのか。** `-g` は SIGTERM をプロセスグループ全体へ転送する。
# デーモンは生ログをこの runner へ渡し切るための60秒の猶予を置いている
# （Railway `drainingSeconds: 60`）。プロセスグループ全体へ即転送すると、この
# 猶予をここで頭から潰すことになる。tini は既定でも子（node 1プロセス）へは
# SIGTERM を転送するので、`-g` が無くても停止自体は届く。
exec tini -- node /app/apps/runner/dist/index.js "$@"
