#!/bin/sh
# alteroidd（デーモン＝クローンと記憶）を起こす。
#
# **root で起きたら `node` へ降りる。** 記憶ストアの鍵を持つのはこのプロセスなので、
# 特権のまま走る理由が無い。
#
# なぜ器の側に持たせるのか。プラットフォームによっては実行 UID を環境変数で指定する
# （Railway の `RAILWAY_RUN_UID`）。runner は子プロセスを別 UID へ降ろすために root が
# 要るので、そこだけ 0 にすると**人間が置く変数が役ごとに割れる**。「root で来ても
# 自分で降りる」を器が引き受ければ、同じ変数一式を両方へ配れる。
#
# 非 root で起きたときは何もしない（`docker compose` の既定はイメージの `USER node`）。
set -eu

entry=/app/apps/daemon/dist/index.js

if [ "$(id -u)" = '0' ]; then
  exec setpriv --reuid=node --regid=node --init-groups node "$entry" "$@"
fi

exec node "$entry" "$@"
