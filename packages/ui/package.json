{
  "name": "@alteroid/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Web UI の見た目の部品（shadcn の部品・汎用の表示部品・テーマの CSS）。API もデーモンも知らない。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./shadcn": "./src/components/ui/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/test.mjs --root=../.. --scope=packages/ui/src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shadcn:add": "node ./scripts/shadcn-add.mjs"
  },
