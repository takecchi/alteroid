    "html-url-attributes": "catalog:",
    "lucide-react": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-newline-to-break": "catalog:",
    "mdast-util-to-hast": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "shadcn": "catalog:",
