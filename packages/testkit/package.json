{
  "name": "@mnemora/testkit",
  "version": "0.1.1",
  "type": "module",
  "description": "adapter（MemoryStore/VectorStore/EventStore の実装）が満たすべき適合テスト一式（conformance suite）。",
  "license": "MIT",
  "homepage": "https://github.com/takecchi/mnemora/tree/main/packages/testkit#readme",
  "bugs": {
    "url": "https://github.com/takecchi/mnemora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takecchi/mnemora.git",
    "directory": "packages/testkit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@mnemora/core": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
