{
  "name": "@alteroid/swr",
  "version": "0.0.0",
  "private": true,
  "description": "Web UI から API を叩く層（ApiProvider と SWR の hooks）。型と呼び出しの出どころは @alteroid/api-client。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support.tsx"
  },
