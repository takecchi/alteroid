{
  "name": "@mnemora/postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MemoryStore / VectorStore / EventStore の Postgres + pgvector 実装（docs/memory-model.md §10）。",
  "license": "UNLICENSED",
  "homepage": "https://github.com/takecchi/mnemora/tree/main/packages/postgres#readme",
  "bugs": {
    "url": "https://github.com/takecchi/mnemora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takecchi/mnemora.git",
    "directory": "packages/postgres"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "bin": {
    "mnemora-postgres-migrate": "./dist/bin/migrate.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "migrate": "tsx src/bin/migrate.ts",
    "test:db": "vitest run",
    "bench:scale": "tsx src/bench/scale-bench.ts"
  },
  "dependencies": {
    "@mnemora/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@mnemora/testkit": "workspace:*",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
