    "test": "vitest run --root=../.. packages/core/src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "croner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
