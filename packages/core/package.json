{
  "name": "@mnemora/core",
  "version": "0.1.1",
  "type": "module",
  "description": "mnemora の core パッケージ。zod 以外の実行時依存を持たない。interface / 型 / 純関数の既定戦略。",
  "license": "MIT",
  "homepage": "https://github.com/takecchi/mnemora/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/takecchi/mnemora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takecchi/mnemora.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
