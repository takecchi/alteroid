{
  "name": "@alteroid/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./usage": {
      "types": "./dist/usage-format.d.ts",
      "import": "./dist/usage-format.js"
    },
    "./revision": {
      "types": "./dist/revision-format.d.ts",
      "import": "./dist/revision-format.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/write-canon.mjs && tsup",
