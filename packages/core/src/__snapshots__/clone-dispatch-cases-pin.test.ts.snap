  "settled: return this.#waiting.handleSettled(event, record);",
  "note: if (event.workerLimit !== undefined) {await this.#note.markWorkerLimitStopped(record, event.managerId, event.workerLimit);} const noteText = event.workerLimit === undefined ? event.text : \`\${event.text}\\n\${await this.#usageWake.describeWorkerLimitKey(event.workerLimit.raw)}\`; await this.#note.journalNote(event, noteText); this.#note.emitNoteNotices(event, noteText); if (event.tokenRotation === true) this.#rememberTokenIdentity(event.managerId); return;",
