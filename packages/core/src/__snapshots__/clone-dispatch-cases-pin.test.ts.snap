  "timer: if (event.kind === DAILY_REPORT_KIND) {await this.#daily.run(event.target ?? localDate(new Date(event.at)), event.cause ?? 'schedule'); return;} const claimed = await this.#claimScheduledRun(event.kind, event.at, event.cause === 'manual' ? 'manual' : 'schedule', event); if (claimed.status !== 'ok' && claimed.status !== 'missing') {await this.#journalSelf('outbound', \`\${EXCHANGE_KIND_DECISION_PREFIX}定期の依頼 \${event.kind} は、この発火では動かない: \${claimed.reason}\`); if (event.cause !== 'manual' && claimed.status !== 'withdrawn' && claimed.status !== 'completed') {this.#onScheduledRunNotStarted?.(event.kind);} return;} const cause = event.cause === 'manual' ? 'manual' : 'schedule'; const journalCause = event.cause ?? 'schedule'; const plan = claimed.status === 'ok' ? claimed.plan : null; const timerDigest = await this.#digest.recentCounts(); await this.#journal(turnInputEntry({type: 'timer', kind: event.kind, cause: journalCause, ...(event.target === undefined ? {} : {target: event.target}), request: plan !== null, digest: timerDigest})); const timerPrompt = buildTimerPrompt({kind: event.kind, ...(event.target === undefined ? {} : {target: event.target}), ...(plan === null ? {} : {request: plan.request}), ...(plan?.lastRunAt === undefined ? {} : {lastRunAt: plan.lastRunAt}), ...(plan?.pendingRun === undefined ? {} : {unfinishedAt: plan.pendingRun.at}), digest: timerDigest}); const outcome = await this.#runInternal(timerPrompt); if (plan !== null) {if (outcome.status === 'failed' && !outcome.heldForUsage) {const prior = this.#timerTurnRetries.get(event.kind); const attempts = prior?.at === event.at ? prior.attempts : 0; const retryDelayMs = cause === 'manual' ? undefined : FAILED_TURN_RETRY_DELAYS_MS[Math.min(attempts, FAILED_TURN_RETRY_DELAYS_MS.length - 1)]; const retryClause = describeFailedTimerRetryClause(retryDelayMs, FAILED_TURN_RETRY_DELAYS_MS.at(-1)!); await this.#journalSelf('outbound', \`\${EXCHANGE_KIND_FAILURE_PREFIX}定期の依頼 \${event.kind}（\${event.at}）のターンが失敗で終わった\` + \`ので「終わった」とは記録しない（引き受けた印は残る。\${retryClause}）: \` + outcome.reason); if (retryDelayMs !== undefined) {this.#timerTurnRetries.set(event.kind, {at: event.at, attempts: attempts + 1}); this.#onScheduledRunNotStarted?.(event.kind, retryDelayMs);}} else {this.#timerTurnRetries.delete(event.kind); if (outcome.status === 'failed' && outcome.heldForUsage) {try {await this.#stores.inbox.put({...event, heldForUsage: true}, event.at);} catch (error) {noteDroppedRecord('枠保持の印の書き込み', inboxEventShape(event), error); return;}} await this.#completeScheduledRun(event.kind, event.at, cause);}} return;",
