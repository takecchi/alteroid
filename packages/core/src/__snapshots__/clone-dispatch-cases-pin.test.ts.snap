  "report: if (record.job.status === 'stopped') {await this.#recordStoppedReport(record, event, fromRunnerId); return;} if (event.reportId !== undefined) {const reported = this.#reportedOf(record); if (reported.has(event.reportId)) return; reported.set(event.reportId, true);} const markedByFailure = this.#reportApply.applyReportToJob(record, event); await this.#persist(record); await this.#journalExchange('inbound', \`\${EXCHANGE_KIND_REPLY_PREFIX}[\${event.managerId}] \${reportFullTextOf(event)}\`); await this.#afterReportRecorded(event, markedByFailure); await this.#deliverReport(record, event, fromRunnerId); return;",
