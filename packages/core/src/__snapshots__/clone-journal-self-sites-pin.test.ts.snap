  "#recordWorkerLimit 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}作業者（\${label}）だけが利用上限で落ちた。クローンは動けるので、枠の印も鍵の回転も起こしていない。\` + \`次の道具の結果に知らせを添える（原文: \${shown.trim().slice(0, 300)}）\`",
  "#workerLimitNotice 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}作業者が利用上限で落ちている（\${String(notice.count)} 体）ので、\` + 'この道具の結果に「戻るまで作業者を立て直しても同じく落ちうる」という知らせを添えた（止める指示ではない）。'",
  "#noteDenial 'inbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}先に書いた \${tool} の拒否について、ターン終わりの記録（合図の出所: result）に\` + \`入力が載っていた。値には鍵が入りうるので本文は残さず、形だけ残す: \${later}\`",
  "#noteDenial 'inbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}\${tool} の実行が、確認へ上がらずに止められた\${why}。\` + \`止められたのは \${actorLabel} の手（合図の出所: \${via}）。\` + \`入力の形: \${denialInputShape(denial.input) ?? denialInputAbsence(via)}。\` + \`許可モードは \${this.#permissionMode} で、この層に確認を回す相手は居ない。\`",
  "#noteGrantFunneled 'inbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}許可 DB の規則 \${funneled.rule}（grant \${funneled.grantId}）で \` + \`PreToolUse が allow を返したのに、同じ呼び出し（合図の出所: \${via}）が拒否された\${why}。\` + guidance",
  "#onSubagentStop 'inbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}許可 DB の規則 \${funneled.rule}（grant \${funneled.grantId}）で \` + \`PreToolUse が allow を返した作業者（agentId: \${agentId}）の呼び出し\` + \`（tool_use_id: \${toolUseId}）が、実行の決着も拒否の記録も無いまま、\` + \`その作業者の SubagentStop を迎えた。決着しなかった。\${guidance}\`",
  "#onPreCompact 'outbound' \`\${EXCHANGE_KIND_RECOVERY_PREFIX}\${continuityText}\`",
  "#onPreCompact 'outbound' \`\${EXCHANGE_KIND_FAILURE_PREFIX}PreCompact の退避に失敗した: \${reasonOf(error)}\`",
  "#onPreCompact 'outbound' \`\${EXCHANGE_KIND_FAILURE_PREFIX}PreCompact の蒸留に失敗した: \${reasonOf(error)}\` + (archiveId !== null ? '（compaction の前の生ログの退避を墓標に残した。鍵が回った・枠が解けた・起動の契機で拾い直す）' : '（⚠️ 退避も失敗しているので墓標を指せず、この区間は記憶へ移せていない）')",
  "#recordUsage 'outbound' \`\${EXCHANGE_KIND_GAUGE_PREFIX}自分の消費の累積が数え直された（\${fold.reset.fromCostUsd.toFixed(4)} → \` + \`\${fold.reset.toCostUsd.toFixed(4)}）。resume か /clear で SDK 側の累積が \` + '0 から始まったため。記録済みの分は保持している。'",
  "#recordUsage 'outbound' \`\${EXCHANGE_KIND_FAILURE_PREFIX}[site=\${site}] 消費を台帳へ記録できなかった（この分は集計に出ない）: \${reasonOf(error)}\`",
  "#read 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}開き直す前の生ログ（古い session id: \` + \`\${previousSessionId ?? '不明'}）: \${describeReopenArchive(archived)}\`",
  "#apply 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}拒否されて降格した（category: \${event.category ?? '不明'}、\` + \`元のモデル: \${event.originalModel ?? '不明'}）。\` [+...(turn?.conversationId == null ? {} : {conversationId: turn.conversationId})]",
  "#applySessionStarted 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}\${described.text}\`",
  "#applySessionStarted 'outbound' \`\${EXCHANGE_KIND_DECISION_PREFIX}開き直した: \${reopened.previousSessionId ?? '（古い id は不明）'}\` + \` → \${event.sessionId}（\${describeReopenArchive(reopened.archive)}）\`",
  "#applyRateLimit 'outbound' \`\${EXCHANGE_KIND_GAUGE_PREFIX}同じ壁を跨いで畳んだ回に、\` + \`\${crossFold.folded.size} 本の異なる会話が当たっている\` + '（前回この壁の遷移を記録してから、いまの遷移までのあいだ）。'",
  "#journalSelf role text",
]
`;
