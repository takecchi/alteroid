  "staleBuffer.push(record);} if (this.#sdkSession.stopped || this.#delivery.inbox.closed) {await flushStaleRemovalBuffer();",
  "await this.#journalRestoreUnreadPassEnd(decided, restoreUnreadPassIndex + (verdict === 'stale' ? 1 : 0), {interrupted: true});",
  "return claimedIds;} this.#delivery.redeliveryState.markRedelivered(record.event.id, record);",
