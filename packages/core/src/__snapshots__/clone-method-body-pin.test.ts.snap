[
  "const pending = await this.#claimPendingUntilStopped();",
  "if (pending === undefined) return new Set();",
  "const claimedIds: ReadonlySet<string> = new Set(pending.map((record) => record.event.id));",
  "this.#restoredCohort = pending.length;",
  "await this.#journalRestoreUnreadPassStart(pending.length);",
  "for (const record of pending) {const key = inboxCollapseKey(record.event);",
  "if (key === undefined) continue;",
  "if (this.#delivery.hasCollapseKey(key)) continue;",
  "this.#delivery.registerCollapseRepresentative(key, record.event.id, record.event.at);} for (const record of pending) {if (record.event.type !== 'external') continue;",
  "if (record.event.source !== DAEMON_TOKEN_POOL_REOPENED_SOURCE) continue;",
  "const key = externalMergeKey(record.event);",
  "if (key === null) continue;",
  "this.#delivery.setPendingTokenPoolNotice({id: record.event.id, at: record.event.at, key, folded: 0});} const alone = this.#restoredCohort <= 1;",
  "const completedRounds = await this.#lastScheduledRunAtByKind(pending);",
  "const completedRoundIds = new Set<string>();",
  "const decided = pending.map((record) => {const base = restoredInboxEventVerdict(record.event);",
  "if (base === 'stale' || record.event.type !== 'timer') return {record, verdict: base};",
  "const completed = completedTimerRoundVerdict(record.event, completedRounds.get(record.event.kind)) === 'stale';",
  "if (completed) completedRoundIds.add(record.event.id);",
  "return {record, verdict: completed ? ('stale' as const) : base};});",
  "const liveRecordsThisPass = decided .filter((entry) => entry.verdict !== 'stale') .map((entry) => entry.record);",
  "if (liveRecordsThisPass.length > 0) {await this.#journalSelf('outbound', \`\${EXCHANGE_KIND_RECOVERY_PREFIX}\${redeliveredLiveHeadline(liveRecordsThisPass, alone, this.#restoredCohort)}\`);} const staleBuffer: PendingInboxEvent[] = [];",
  "const flushStaleRemovalBuffer = async (): Promise<void> => {if (staleBuffer.length === 0) return;",
  "const batch = staleBuffer.splice(0, staleBuffer.length);",
  "for (let i = 0;",
  "i < batch.length;",
  "i += RESTORE_STALE_REMOVE_CHUNK_MAX_IDS) {await this.#removeStaleRedeliveryChunk(batch.slice(i, i + RESTORE_STALE_REMOVE_CHUNK_MAX_IDS));}};",
  "for (const [restoreUnreadPassIndex, {record, verdict}] of decided.entries()) {if (this.#sdkSession.stopped || this.#delivery.inbox.closed) {await flushStaleRemovalBuffer();",
  "await this.#journalRestoreUnreadPassEnd(decided, restoreUnreadPassIndex, {interrupted: true});",
  "return claimedIds;} if (this.#postedBeforeRestored.has(record.event.id)) continue;",
