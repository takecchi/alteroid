    "mcp__alteroid__inbox_remove_many",
    "mcp__alteroid__profile_read",
    "mcp__alteroid__profile_write",
    "mcp__alteroid__profile_remove",
    "mcp__alteroid__practice_list",
    "mcp__alteroid__practice_read",
