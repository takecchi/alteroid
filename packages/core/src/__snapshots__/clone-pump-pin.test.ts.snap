// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`clone.ts の受信箱のループ（#pump）の中身を固定する（ターンの前の組み立てと後始末を出す前後で変わらないことの歯） > #pump: 出した先を差し戻した中身が変わらない 1`] = `
[
  "void this.#restoreUnread().catch((error: unknown) => {noteDroppedRecord('未読の読み直し', '', error);});",
  "void this.#sweepGraves();",
  "for await (const event of this.#delivery.inbox) {this.#inFlight = {events: [event], started: false};",
  "const arrivedWhileIdle = this.#delivery.inbox.consumeBypass(event);",
  "if (this.#releaseRequested && !this.#delivery.inbox.closed) {this.#releaseRequested = false;",
  "if (this.#usageBlocked !== null) {this.#usageBlocked = null;",
  "this.#retryGravesFor('枠の保持を解いた');",
  "const held = this.#delivery.drainDeferred();",
  "this.#delivery.inbox.unshift([...held, event]);",
  "this.#inFlight = null;",
  "const suppressedRearms = this.#usageBlockSuppressedRearms;",
  "const foldedInternalFailures = this.#usageBlockFoldedInternalFailures;",
  "this.#usageBlockSuppressedRearms = 0;",
  "this.#usageBlockFoldedInternalFailures = 0;",
  "const counts = (suppressedRearms > 0 ? \` 回復予定時刻より前だったので再武装を抑止: \${String(suppressedRearms)} 回。\` : '') + (foldedInternalFailures > 0 ? \` 人間が待っていない内部の失敗記録を畳んだ: \${String(foldedInternalFailures)} 件。\` : '');",
  "const suffix = counts === '' ? '' : \`\${counts}（件数・回数は、この枠の区間でこのプロセスが数えた分だけ。器の入れ替えを跨いだ分と、ターンの成功で枠が降りた回の分は数えずに0へ戻るので、実際より少ない＝下限。）\`;",
  "await this.#journalSelf('outbound', \`\${EXCHANGE_KIND_THINNING_PREFIX}枠の解除を試す。新しい合図が届いたので、保持していた \${held.length} 件を配り直す。\${suffix}\`);",
  "continue;}} if (this.#usageBlocked !== null) {const notice = this.#usageBlocked;",
  "this.#emit(this.#conversationOf(event), {type: 'usage_limited', message: describeUsageNotice(notice)});",
  "if (this.#conversationOf(event) === null) {this.#usageBlockFoldedInternalFailures += 1;} else {await this.#reportFailure(this.#conversationOf(event), '枠が閉じているので、いまは投げていない。合図は保持してある。次に別の合図が' + \`届いたとき、保持した分から順に試し直す（\${describeUsageNotice(notice)}）\`);} await this.#settleInboxEvent(event, true);",
  "this.#inFlight = null;",
  "continue;} const quotaFold = await this.#recoveredFoldNoticeFor(event, 'quota');",
  "if (quotaFold !== null) {await this.#foldRecoveredNotice(event, quotaFold, 'quota');",
  "await this.#settleInboxEvent(event, false);",
  "this.#inFlight = null;",
  "continue;} const recoveredFold = await this.#recoveredFoldNoticeFor(event, 'recovered');",
  "if (recoveredFold !== null) {await this.#foldRecoveredNotice(event, recoveredFold, 'recovered');",
  "await this.#settleInboxEvent(event, false);",
  "this.#inFlight = null;",
  "continue;} if (arrivedWhileIdle && !this.#delivery.inbox.closed && isSettleCandidate(event)) {const wait = settleWaitFor(event, this.#reportSettleMs, this.#inboxSettleMs);",
  "if (wait.ms > 0) await this.#delivery.inbox.settle(wait.ms, wait.interruptWhen);} this.#notices.set('mergedBatchTruncation', '');",
  "const mergedHuman = this.#mergedHumanBatch(event);",
  "const sameManagerReports = this.#mergedManagerReportBatch(event);",
  "const mergedExternal = this.#mergedExternalBatch(event);",
  "const extendedSignals = sameManagerReports === null ? null : this.#extendReportBatchToMixed(sameManagerReports);",
  "const mergedReports = extendedSignals === null ? sameManagerReports : null;",
  "const mergedSignals = extendedSignals ?? (mergedHuman === null && sameManagerReports === null && mergedExternal === null ? this.#mixedSignalBatch(event) : null);",
  "const batch: InboxEvent[] = mergedHuman ?? mergedReports ?? mergedExternal ?? mergedSignals ?? [event];",
  "this.#inFlight = {events: batch, started: false};",
  "for (const taken of batch) this.#dropPendingCollapse(taken);",
  "const timer = new TurnTimer({now: Date.now, arrivedAt: Math.min(...batch.map((queued) => {const at = Date.parse(queued.at);",
  "return Number.isNaN(at) ? Date.now() : at;})), triggers: batch.map((queued) => queued.type), batchSize: batch.length});",
  "this.#turnTimer = timer;",
  "const prepareStartedAt = Date.now();",
  "this.#digestDelta.discardStaged();",
  "this.#digestResetLoggedThisTurn = false;",
  "await this.#restoreFoldStateOnce();",
  "this.#resetDigestDeltaIfNewConversation();",
  "this.#applyFoldPeriod(batch);",
  "this.#notices.set('redelivery', this.#redeliveryNoticeFor(batch));",
  "this.#notices.set('commitment', await timer .time('prepare.taskQueue', () => this.#taskQueueNoticeFor(batch)) .catch((error: unknown) => {noteDroppedRecord('待ち行列の断り書きの組み立て', inboxEventShape(event), error);",
  "return '';}));",
  "this.#notices.set('situation', await timer .time('prepare.situation', () => this.#situationNoticeFor(batch)) .catch((error: unknown) => {noteDroppedRecord('いまの全体の組み立て', inboxEventShape(event), error);",
  "return describeSituationUnavailable(error);}));",
  "const validityNotice = await timer.time('prepare.validity', () => this.#validityNoticeFor(batch));",
  "this.#notices.set('validity', (await timer.time('prepare.quotaRecovery', () => this.#quotaRecoveryNoticeFor(batch))) + validityNotice);",
  "if (validityNotice !== '' && event.type === 'manager_message') {await this.#noteRedeliveryPredicateHitB(event.managerId);} timer.add('prepare', Date.now() - prepareStartedAt);",
  "this.#pumpTurnFailed = false;",
  "this.#droppedSignalsShown = new Set();",
  "try {if (mergedHuman !== null) await this.#runHumanTurn(mergedHuman);",
  "else if (mergedReports !== null) await this.#runManagerReportBatch(mergedReports);",
  "else if (mergedExternal !== null) await this.#runExternalBatch(mergedExternal);",
  "else if (mergedSignals !== null) await this.#runMixedSignalBatch(mergedSignals);",
  "else await this.#handle(event);} catch (error) {await this.#reportFailure(this.#conversationOf(event), {error});",
  "this.#finishTurn();} finally {this.#notices.clearTurn();",
  "this.#situationExplainedStaged = null;",
  "this.#taskQueueHeadStaged = null;",
  "this.#digestDelta.discardStaged();",
  "if (this.#pumpTurnFailed) {this.#returnToFullText({situation: true, digest: {reason: 'full', label: 'turn_failed'}});} const defer = this.#usageBlocked !== null;",
  "const failedOutsideUsage = !defer && this.#pumpTurnFailed;",
  "await this.#noteDroppedSignals(batch, {failedOutsideUsage, defer});",
  "for (const held of batch) {if (defer && held.type === 'human_answer') this.#handledHumanAnswerIds.delete(held.id);",
  "if (failedOutsideUsage && held.type === 'human_answer') {this.#handledHumanAnswerIds.delete(held.id);",
  "await this.#reopenAnswerDeliveryAfterFailure(held);} await this.#settleInboxEvent(held, defer);} this.#turnTimer = null;",
  "await this.#writeTurnTiming(timer, this.#pumpTurnFailed);",
  "this.#inFlight = null;}} this.#delivery.settleAllCompletions();",
]
`;
