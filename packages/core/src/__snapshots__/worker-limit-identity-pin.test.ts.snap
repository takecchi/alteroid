  },
  {
    "identities": [
      "task:task-T",
      "tool_use:toolu-X",
    ],
    "label": "tool_use toolu-X ・task task-T",
    "recorded": false,
  },
  {
    "identities": [
      "tool_use:toolu-X",
    ],
    "label": "tool_use toolu-X",
    "recorded": false,
  },
  {
    "identities": [
      "task:task-T",
      "tool_use:toolu-X",
    ],
    "label": "tool_use toolu-X ・task task-T",
    "recorded": false,
  },
]
`;

