{
  "name": "alteroid-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:agents-md-size": "node ./scripts/check-agents-md-size.mjs",
    "check:base-overlap": "node ./scripts/check-base-overlap.mjs",
    "check:keyword-closed-issues": "node ./scripts/check-keyword-closed-issues.mjs",
    "check:no-attribution-trailers": "node ./scripts/check-no-attribution-trailers.mjs",
    "check:pr-closing-keywords": "node ./scripts/check-pr-closing-keywords.mjs",
    "check:pr-green": "node ./scripts/check-pr-green.mjs",
    "check:pr-line-number-citations": "node ./scripts/check-pr-line-number-citations.mjs",
    "check:pr-title-type": "node ./scripts/check-pr-title-type.mjs",
    "check:pr-vanished-footprint": "node ./scripts/check-pr-vanished-footprint.mjs",
    "check:required-status-checks": "node ./scripts/check-required-status-checks.mjs",
    "check:sdk-quotes": "node ./scripts/check-sdk-quotes.mjs",
    "check:web-bundle-node-traces": "node ./scripts/check-web-bundle-node-traces.mjs",
    "check:web-bundle-size": "node ./scripts/check-web-bundle-size.mjs",
    "check:web-css-comment-classnames": "node ./scripts/check-web-css-comment-classnames.mjs",
    "issue-done-trailer": "node ./scripts/issue-done-trailer.mjs",
    "main-ci-alarm": "node ./scripts/main-ci-alarm.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.railway.json && tsc --noEmit -p tsconfig.docker.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.github-scripts.json && tsc --noEmit -p tsconfig.tsup.json && tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint .",
    "test": "node ./scripts/test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node ./scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
