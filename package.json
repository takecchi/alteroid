{
  "name": "alteroid-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "branch:deletable": "node ./scripts/branch-deletable.mjs",
    "build": "pnpm -r build",
    "check:advice-single-source": "node ./scripts/check-advice-single-source.mjs",
    "check:agents-md-size": "node ./scripts/check-agents-md-size.mjs",
    "check:no-attribution-trailers": "node ./scripts/check-no-attribution-trailers.mjs",
    "check:pr-green": "node ./scripts/check-pr-green.mjs",
    "check:required-status-checks": "node ./scripts/check-required-status-checks.mjs",
    "check:sdk-quotes": "node ./scripts/check-sdk-quotes.mjs",
    "check:verified-head": "node ./scripts/check-verified-head.mjs",
    "check:web-build-output": "node ./scripts/check-web-build-output.mjs",
    "check:web-bundle-size": "node ./scripts/check-web-bundle-size.mjs",
    "issue-done-trailer": "node ./scripts/issue-done-trailer.mjs",
    "main-ci-alarm": "node ./scripts/main-ci-alarm.mjs",
    "storybook": "pnpm --filter @alteroid/ui storybook",
    "typecheck": "node ./scripts/check-typecheck-prereqs.mjs && pnpm -r typecheck && tsc --noEmit -p tsconfig.railway.json && tsc --noEmit -p tsconfig.docker.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.github-scripts.json && tsc --noEmit -p tsconfig.tsup.json && tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint .",
    "test": "node ./scripts/test.mjs",
    "test:shard-files": "node ./scripts/test-shard-files.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node ./scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.0"
  }
}
