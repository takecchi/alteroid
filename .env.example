# alteroid の環境変数。`cp .env.example .env` して、上の3つを埋める。
#
#   docker compose up -d
#   docker compose exec app alteroid chat
#
# **app（デーモン）と runner は同じものを受け取る。** 役ごとに違うのは
# `ALTEROID_DATABASE_URL`（記憶ストアの鍵）だけで、compose では POSTGRES_PASSWORD から
# app にだけ組み立てられる。Railway でも同じで、これ以外は Shared Variables に置ける
# （railway/README.md）。

# --- 埋めるもの（3つ） ---------------------------------------------------

# クローンとマネージャーの認証。`claude setup-token` で取る（人間が一度だけ）
CLAUDE_CODE_OAUTH_TOKEN=

# app ↔ runner の制御面の合鍵。`openssl rand -hex 32`
# **同じ値を両方が持つだけでよい。** runner は起動時に sha256 へ畳み、素の値を
# 自分の環境から落としてから走る（docker/alteroid-runner）
ALTEROID_RUNNER_TOKEN=

# compose の PostgreSQL のパスワード。`openssl rand -hex 16`
# 既定値は置かない（置けば「compose を読めば入れる」DB になる）
POSTGRES_PASSWORD=

# --- ここから下を増やす前に ---------------------------------------------
#
# **道具の鍵や PATH は、ここではなく実行環境プロファイルに書く。**
#
#   alteroid profile edit          # 手元
#   docker compose exec app alteroid profile edit
#
# 人間の `~/.zprofile` に当たるもので、記憶ストア側に置かれ、クローン・
# マネージャー・作業者のすべてに効く。**器を作り直さずに差し替えられる**（走行中の
# マネージャーにも次のコマンドから届く）ので、鍵を1つ足すたびにここを直して
# `docker compose up -d` し直す必要が無い。
#
# ここに残してあるのは、**プロファイルが降りる前から要るもの**だけである
# （デーモンと runner が起動するために要る鍵と、記憶ストアの所在）。

# --- 任意 ---------------------------------------------------------------

# 日報の締め時刻がこれで決まる。未設定だと UTC で動く
TZ=Asia/Tokyo

# 自律の既定（方針であって、実行回数の制限ではない）。`off` で止まる
#ALTEROID_DAILY_REPORT_AT=22:00
#ALTEROID_INITIATIVE_EVERY=55

# 握り潰した報告（背景処理の完了待ちで畳んだ報告）を、次のターンが来ないまま
# 時間切れで配り直すまでの猶予（ms）。既定は30分（1800000ms）。未設定・空・
# 0以下・数値でない値は既定へ落ちる
#ALTEROID_WITHHELD_REPORT_FLUSH_MS=1800000

# 層とモデル帯の対応（クローン Fable / マネージャー Opus / 作業者 Sonnet）を差し替える。
# **これは設定ではなく、人間の承認の置き場である** — 対応は設計判断であり、変更には人間の
# 承認が要る。費用を詰めるための旋盤ではないので、コメントのままにしておくのが既定である。
# 置いた事実は起動時に必ず表へ出る（黙って上位帯から降りることを許さない）。
#
# manager / worker を実際に SDK へ渡すのは runner で、そこが正本である。app は自己認識に
# **宣言**を載せるだけだが、同じ値が両方へ降りるので食い違わない。空・空白は「未設定」
# として既定へ落ちるので、空で置いても壊れない。
#
# **`alteroid profile edit` では解けない。** 読むのは器自身の環境変数なのでプロファイルは
# 届かず、しかもプロファイルは**クローン自身が書ける**ので、そこから読めばクローンが自分の
# モデル帯を差し替えられる ＝ 承認が承認でなくなる。
#ALTEROID_CLONE_MODEL=fable
#ALTEROID_MANAGER_MODEL=opus
#ALTEROID_WORKER_MODEL=sonnet

# 台帳が委譲先を引く安定した識別子。**器ごとに違う値でなければならない**（同じ値を
# 2台が名乗ると、台帳の `manager_id → runner_id` を引く名簿が線形一致で先に見つかった
# 方を黙って返すので、manager_send が割り当て先ではない器へ届く）。
# Railway で台数を増やすときは `railway/scale-runners.sh` が台ごとに置く。
#ALTEROID_RUNNER_ID=runner-primary

# Railway に建てるときの runner の台数（`railway/setup.sh -c` と同じもの）。
# **既定は1。台数はそのまま費用である**（能力の上限ではない — 配置は実行環境の資源で
# 決まり、人工の定員は置かない）。既に建っているものを増やすのは scale-runners.sh。
#ALTEROID_RUNNER_COUNT=1

# マネージャーの作業ディレクトリをホストのディレクトリにする場合（所有者を uid 1001 に）
#ALTEROID_WORKSPACE_HOST=./workspace

# 画面（apps/web）を**別のオリジン**に置くときだけ要る。ブラウザから叩いてよい
# オリジンの明示列挙で、`*` と経路付きの値は警告を出して捨てる。
# 未設定なら CORS ヘッダを一切返さない（＝既定の姿勢は変わらない）。
#
# **これはブラウザにしか効かない。** `curl` は素通りするので、外から届く場所に
# 置くなら手前に境界（下の Google ログイン・リバースプロキシ・トンネル）を置くこと。
#ALTEROID_ALLOWED_ORIGINS=https://www.example.com,https://www.hoge.vercel.app

# --- 外から HTTP API を叩かせる（Google ログイン）------------------------
#
# **ログインしただけでは使えない。** 使う許可は人間が CLI から与える:
#
#   docker compose exec app alteroid access list
#   docker compose exec app alteroid access grant <アカウント id>
#
# 許可できるアカウントは1つだけ（alteroid は単一の持ち主のもの）。Google に登録する
# Redirect URI は `<ALTEROID_PUBLIC_URL>/auth/google/callback` の1本だけでよい。
#
# 未設定なら認証を要求しない（ポートを公開していない既定の構成では、境界は
# 待ち受け先の側にある）。**この2つの鍵は runner の起動時に落ちる**ので、
# 置き場を分ける必要は無い（docker/alteroid-runner）。
#
#ALTEROID_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#ALTEROID_GOOGLE_CLIENT_SECRET=
#ALTEROID_PUBLIC_URL=https://alteroid.example

# 鍵の有無から自動で決まるが、明示的に上書きもできる（方針は設定で開けられること）
#ALTEROID_AUTH=off
# 発行するアクセストークンの寿命（日）。`off` で無期限。既定は 30
#ALTEROID_ACCESS_TOKEN_TTL_DAYS=30

# --- マネージャーに GitHub を渡す（PR を出させる）------------------------
#
# **新しく置くなら `alteroid profile edit` のほうが早い**（器を焼き直さずに済む。
# gh / git はその場から新しい鍵を使う）。ここは既存の構成のために残してある。
#
# **空のまま置かないこと。** 空文字は未設定より悪い（git が `empty ident name` で
# 即死する / gh が hosts.yml まで無視する）。使わないなら行ごとコメントのままにする。
# fine-grained PAT: Contents RW / Pull requests RW
#
#GH_TOKEN=github_pat_xxx
#GIT_AUTHOR_NAME=
#GIT_AUTHOR_EMAIL=
#GIT_COMMITTER_NAME=
#GIT_COMMITTER_EMAIL=
