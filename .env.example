# alteroid の環境変数。`cp .env.example .env` して、上の3つを埋める。
#
#   docker compose up -d
#   docker compose exec app alteroid chat
#
# **app（デーモン）と runner は同じものを受け取る。** 役ごとに違うのは
# `ALTEROID_DATABASE_URL`（記憶ストアの鍵）だけで、compose では POSTGRES_PASSWORD から
# app にだけ組み立てられる。Railway でも同じで、これ以外は Shared Variables に置ける
# （railway/README.md）。

# --- 埋めるもの（3つ） ---------------------------------------------------

# クローンとマネージャーの認証。`claude setup-token` で取る（人間が一度だけ）
CLAUDE_CODE_OAUTH_TOKEN=

# app ↔ runner の制御面の合鍵。`openssl rand -hex 32`
# **同じ値を両方が持つだけでよい。** runner は起動時に sha256 へ畳み、素の値を
# 自分の環境から落としてから走る（docker/alteroid-runner）
ALTEROID_RUNNER_TOKEN=

# compose の PostgreSQL のパスワード。`openssl rand -hex 16`
# 既定値は置かない（置けば「compose を読めば入れる」DB になる）
POSTGRES_PASSWORD=

# --- 任意 ---------------------------------------------------------------

# 日報の締め時刻がこれで決まる。未設定だと UTC で動く
TZ=Asia/Tokyo

# 自律の既定（方針であって、実行回数の制限ではない）。`off` で止まる
#ALTEROID_DAILY_REPORT_AT=22:00
#ALTEROID_INITIATIVE_EVERY=60

# 台帳が委譲先を引く安定した識別子
#ALTEROID_RUNNER_ID=runner-primary

# マネージャーの作業ディレクトリをホストのディレクトリにする場合（所有者を uid 1001 に）
#ALTEROID_WORKSPACE_HOST=./workspace

# 画面（apps/web）を**別のオリジン**に置くときだけ要る。ブラウザから叩いてよい
# オリジンの明示列挙で、`*` と経路付きの値は警告を出して捨てる。
# 未設定なら CORS ヘッダを一切返さない（＝既定の姿勢は変わらない）。
#
# **これはブラウザにしか効かない。** `curl` は素通りするので、外から届く場所に
# 置くなら手前に境界（リバースプロキシ・トンネル・認証）を置くのが先である。
#ALTEROID_ALLOWED_ORIGINS=https://www.example.com,https://www.hoge.vercel.app

# --- マネージャーに GitHub を渡す（PR を出させる）------------------------
#
# **空のまま置かないこと。** 空文字は未設定より悪い（git が `empty ident name` で
# 即死する / gh が hosts.yml まで無視する）。使わないなら行ごとコメントのままにする。
# fine-grained PAT: Contents RW / Pull requests RW
#
#GH_TOKEN=github_pat_xxx
#GIT_AUTHOR_NAME=
#GIT_AUTHOR_EMAIL=
#GIT_COMMITTER_NAME=
#GIT_COMMITTER_EMAIL=
