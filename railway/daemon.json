{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/cli/**",
      "apps/daemon/**",
      "packages/**",
      "Dockerfile",
      ".dockerignore",
      "docker/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "railway/daemon.json"
    ]
  },
  "deploy": {
    "startCommand": "alteroidd",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60,
    "restartPolicyMaxRetries": 100
  }
}
