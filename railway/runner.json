{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/runner/**",
      "packages/**",
      "Dockerfile",
      ".dockerignore",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "railway/runner.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/runner/dist/index.js",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
